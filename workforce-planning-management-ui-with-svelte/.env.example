# Workforce Planning Management Service base URL (no trailing slash).
# Server-side only — read by src/lib/server/config.ts and never reaches
# the browser bundle. 5150 is the loco.rs default port the service
# binds in dev.
WPM_API_URL=http://localhost:5150

# Authentication Service base URL (no trailing slash). Server-side only.
# Used for the session -> PASETO exchange (src/lib/server/auth.ts) and the
# magic-link request/verify flow (/signin, /verify — WPM-T18).
AUTH_API_URL=http://localhost:5150

# Public address of this site (no trailing slash), used for /sitemap.xml and
# /robots.txt. Blank = the request origin; set it when the app sits behind a
# proxy that rewrites the host. Server-side only.
WPM_PUBLIC_URL=
