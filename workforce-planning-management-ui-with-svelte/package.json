{
  "name": "workforce-planning-management-ui-with-svelte",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "SvelteKit front-end for the Workforce Planning Management Service: HR, manager, and employee self-service views over the employment lifecycle.",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workforce-planning-management/workforce-planning-management.git",
    "directory": "workforce-planning-management-ui-with-svelte"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write src",
    "lint": "prettier --check src",
    "sync-themes": "node scripts/sync-themes.mjs",
    "cms-config": "node scripts/cms-config.mjs",
    "cms-config:check": "node scripts/cms-config.mjs --check",
    "postinstall": "node scripts/sync-themes.mjs",
    "api:types": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/schema.d.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "dependencies": {
    "@lilydesignsystem/svelte-calendar": "0.7.0",
    "@lilydesignsystem/svelte-data-grid": "0.11.0",
    "@lilydesignsystem/svelte-gantt-chart": "0.8.0",
    "@lilydesignsystem/svelte-headless": "0.5.1",
    "@lilydesignsystem/svelte-kanban-board": "0.8.1",
    "@lilydesignsystem/svelte-link-picker": "0.2.0",
    "@lilydesignsystem/svelte-locale-picker": "0.3.0",
    "@lilydesignsystem/svelte-locale-translations": "0.1.0",
    "@lilydesignsystem/svelte-picker-bar": "0.4.0",
    "@lilydesignsystem/svelte-search-picker": "0.2.0",
    "@lilydesignsystem/svelte-share-picker": "0.3.0",
    "@lilydesignsystem/svelte-text-size-picker": "0.3.0",
    "@lilydesignsystem/svelte-theme-picker": "0.3.0",
    "@lilydesignsystem/themes": "0.5.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
