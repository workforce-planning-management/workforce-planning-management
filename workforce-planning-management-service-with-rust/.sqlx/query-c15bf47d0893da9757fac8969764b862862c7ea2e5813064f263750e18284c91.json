  "query": "SELECT i.pid, i.asset_pid, i.issued_on, i.returned_on, i.outcome, i.note,\n                  a.kind AS \"kind?\", a.tag AS \"tag?\"\n           FROM asset_issues i\n           LEFT JOIN assets a ON a.pid = i.asset_pid\n           WHERE i.worker_pid = $1\n           ORDER BY i.issued_on DESC",
