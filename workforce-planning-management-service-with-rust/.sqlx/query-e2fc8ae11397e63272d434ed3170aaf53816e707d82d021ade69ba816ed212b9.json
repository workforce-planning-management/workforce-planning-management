  "query": "SELECT created_at, updated_at, id, pid, department,\n                  starts_at, ends_at, required_headcount, deleted_at\n             FROM shifts WHERE deleted_at IS NULL AND ($1::text IS NULL OR department = $1)\n            ORDER BY starts_at, id\n            LIMIT 1000",
