{
  "db_name": "PostgreSQL",
  "query": "SELECT a.pid, s.department, s.starts_at\n             FROM shift_assignments a\n             JOIN shifts s ON s.pid = a.shift_pid AND s.deleted_at IS NULL\n            WHERE a.worker_pid = $1 AND a.deleted_at IS NULL\n            ORDER BY a.id",
