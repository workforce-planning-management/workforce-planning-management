  "query": "SELECT m.pid, COALESCE(g.name, '') AS \"name!\"\n             FROM group_members m\n             LEFT JOIN groups g ON g.pid = m.group_pid\n            WHERE m.worker_pid = $1 AND m.role = 'lead' AND m.left_at IS NULL\n            ORDER BY m.id",
