  "query": "SELECT o.pid, o.starts_on, o.ends_on, COALESCE(r.name, '') AS \"name!\"\n             FROM rota_overrides o\n             LEFT JOIN rotas r ON r.pid = o.rota_pid\n            WHERE o.worker_pid = $1 AND o.ends_on >= $2\n            ORDER BY o.id",
