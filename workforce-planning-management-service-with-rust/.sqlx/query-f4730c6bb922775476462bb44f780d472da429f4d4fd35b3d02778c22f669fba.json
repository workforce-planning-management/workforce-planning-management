  "query": "SELECT a.worker_pid, a.pool_pid, a.source_ref, a.from_month, a.to_month, a.fte_centi\n           FROM allocations a JOIN workers w ON w.pid = a.worker_pid AND w.deleted_at IS NULL\n          WHERE a.organization_ref = $1 AND a.deleted_at IS NULL AND a.status = 'confirmed'",
