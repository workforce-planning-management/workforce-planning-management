  "query": "SELECT r.skill_pid, s.name AS \"name?\", r.min_proficiency, r.source_level, r.source_scale_max, r.importance,\n                      r.note\n                 FROM role_skill_requirements r\n                 LEFT JOIN skills s ON s.pid = r.skill_pid\n                WHERE r.role_profile_pid = $1\n                ORDER BY r.id",
