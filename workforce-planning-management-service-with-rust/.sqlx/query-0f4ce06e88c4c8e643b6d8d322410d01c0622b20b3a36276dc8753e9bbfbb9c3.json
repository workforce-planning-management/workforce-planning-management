  "query": "SELECT i.pid, i.title\n           FROM movement_items i\n           JOIN movements m ON m.pid = i.movement_pid\n          WHERE i.assignee_pid = $1 AND i.done_on IS NULL AND i.skipped_reason IS NULL\n            AND m.status = 'open' AND m.worker_pid <> $1\n          ORDER BY i.id",
