  "query": "SELECT b.pid, COALESCE(w.display_name, '') AS \"name!\"\n             FROM worker_backups b\n             LEFT JOIN workers w ON w.pid = b.worker_pid AND w.deleted_at IS NULL\n            WHERE b.backup_pid = $1 AND b.deleted_at IS NULL\n            ORDER BY b.id",
