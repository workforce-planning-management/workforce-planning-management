# Container image for the workforce-planning-management service.
#
# Build from this directory:
#   podman build -f Containerfile -t workforce-planning-management .
#
# The release workflow passes the OCI label values, so the image says which
# version and commit it is (VERSION is the crate version in Cargo.toml, and the
# workflow checks that it, the tag and the label agree):
#   podman build -f Containerfile --build-arg VERSION=0.1.0 --build-arg REVISION=$(git rev-parse HEAD) .
#
# The image runs as a non-root user and carries the binary and `config/`.
# Pick the configuration with LOCO_ENV: `production` (the default here)
# refuses to start without sign-in enforcement and a token key source; `demo`
# is the container demo used by ../compose.yaml.

# Base images are pinned by digest (WPM-T195), so a rebuild gets the same bytes; the tag says what the digest was.
# To move them: look up the tag's current index digest, change it here, build, and run the tests.
FROM docker.io/library/rust:1@sha256:09027f873d45b8ecd1dc86f1fa13b7a62b875c961f017a0e331267b350430137 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migration ./migration
COPY src ./src
RUN cargo build --release --locked --bin workforce-planning-management

FROM docker.io/library/debian:stable-slim@sha256:13e0a2e78aa0554ad5ff66e4e260c6dbcdff807eb1f39d43b9fb0288aae88b04 AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin wpm
ARG VERSION=unknown
ARG REVISION=unknown
LABEL org.opencontainers.image.title="workforce-planning-management" \
      org.opencontainers.image.description="Workforce planning management service (demo software; synthetic data only)" \
      org.opencontainers.image.source="https://github.com/workforce-planning-management/workforce-planning-management" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"
WORKDIR /app
COPY --from=build /src/target/release/workforce-planning-management /app/
COPY config /app/config
ENV LOCO_ENV=production \
    PORT=5150
USER wpm
EXPOSE 5150
# No HEALTHCHECK: the slim runtime has no HTTP client. Probe GET /_health from
# the orchestrator.
ENTRYPOINT ["/app/workforce-planning-management"]
CMD ["start"]
