# Container image for the workforce-planning-management service.
#
# Build from this directory (podman or docker):
#   podman build -f Containerfile -t workforce-planning-management-service .
#
# The image runs as a non-root user and carries the binary and `config/`.
# Pick the configuration with LOCO_ENV: `production` (the default here)
# refuses to start without sign-in enforcement and a token key source; `demo`
# is the container demo used by ../compose.yaml.

FROM docker.io/library/rust:1 AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY migration ./migration
COPY src ./src
RUN cargo build --release --locked --bin workforce-planning-management-service

FROM docker.io/library/debian:stable-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --home-dir /app --shell /usr/sbin/nologin wpm
WORKDIR /app
COPY --from=build /src/target/release/workforce-planning-management-service /app/
COPY config /app/config
ENV LOCO_ENV=production \
    PORT=5150
USER wpm
EXPOSE 5150
# No HEALTHCHECK: the slim runtime has no HTTP client. Probe GET /_health from
# the orchestrator.
ENTRYPOINT ["/app/workforce-planning-management-service"]
CMD ["start"]
