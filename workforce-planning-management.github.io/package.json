{
  "name": "workforce-planning-management.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "=26"
  },
  "description": "The Workforce Planning Management documentation site for GitHub Pages: a static SvelteKit build of the repository's documents and role briefs.",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "sync:check": "node scripts/sync-content.mjs --check",
    "sync-themes": "node scripts/sync-themes.mjs",
    "postinstall": "node scripts/sync-themes.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lilydesignsystem/svelte-headless": "0.9.0",
    "@lilydesignsystem/svelte-picker-bar": "0.6.0",
    "@lilydesignsystem/themes": "0.6.2",
    "marked": "18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "8.3.7"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
