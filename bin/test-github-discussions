#!/bin/bash
# Test script for GitHub Discussions
# Verifies that discussion category files exist and links work

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

echo "Testing GitHub Discussions..."
echo ""

# Each post: the title on line 1, a blank line, then the body, which starts
# with the category it belongs to (see the github-discussion-first-post-for-*
# skills).
FILES=(
    "locales/en-us/communications/github-discussions/announcements.txt:Announcements"
    "locales/en-us/communications/github-discussions/general.txt:General"
    "locales/en-us/communications/github-discussions/ideas.txt:Ideas"
    "locales/en-us/communications/github-discussions/polls.txt:Polls"
    "locales/en-us/communications/github-discussions/qa.txt:Q&A"
    "locales/en-us/communications/github-discussions/show-and-tell.txt:Show and tell"
)

# Test 1: Verify each file exists and has the post shape
echo "=== Test 1: Verifying files ==="
for file_category in "${FILES[@]}"; do
    file="${file_category%%:*}"
    category="${file_category#*:}"

    if [ ! -f "$file" ]; then
        echo "FAIL: File does not exist: $file"
        exit 1
    fi

    title=$(sed -n 1p "$file")
    blank=$(sed -n 2p "$file")
    category_line=$(sed -n 3p "$file")
    if [ -z "$title" ] || [ -n "$blank" ] || [ "$category_line" != "Category: $category" ]; then
        echo "FAIL: File $file is not a title, a blank line, then \"Category: $category\""
        exit 1
    fi
    if [ "$(wc -l < "$file")" -lt 5 ]; then
        echo "FAIL: File $file has no body"
        exit 1
    fi

    echo "PASS: $file is the $category post: $title"
done

echo ""
echo "=== Test 2: Verifying links ==="

# Get the slug from the repository
# Try to get it from the git remote
SLUG="workforce-planning-management"

# Test the org discussions URL
echo "Checking https://github.com/orgs/$SLUG/discussions..."
ORG_URL="https://github.com/orgs/$SLUG/discussions"

# Use curl to check if the page contains "View All Discussions"
if command -v curl &> /dev/null; then
    # Check for "View All Discussions" text
    if curl -s -L "$ORG_URL" | grep -q "View All Discussions"; then
        echo "PASS: $ORG_URL contains 'View All Discussions'"
    else
        echo "WARN: $ORG_URL does not contain 'View All Discussions' (page may have changed)"
    fi
    
    # Check redirect from /[slug]/[slug]/discussions to /orgs/[slug]/discussions
    REPO_URL="https://github.com/$SLUG/$SLUG/discussions"
    echo "Checking redirect from $REPO_URL to $ORG_URL..."
    
    # Get the final URL after redirects
    FINAL_URL=$(curl -s -L -o /dev/null -w '%{url_effective}' "$REPO_URL")
    if [ "$FINAL_URL" = "$ORG_URL" ] || [ "$FINAL_URL" = "$ORG_URL/" ]; then
        echo "PASS: $REPO_URL redirects to $ORG_URL"
    else
        echo "WARN: $REPO_URL redirects to $FINAL_URL (expected $ORG_URL)"
    fi
else
    echo "WARN: curl is not installed, skipping link verification"
fi

echo ""
echo "All tests passed!"
exit 0
