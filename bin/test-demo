#!/bin/bash
# test-demo: Launch the WPM demo and run end-to-end tests
#
# This script:
# 1. Starts the WPM service in the background
# 2. Seeds the database with demo data
# 3. Starts the WPM UI in the background
# 4. Waits for both services to be ready
# 5. Runs end-to-end tests against the live demo
# 6. Cleans up by stopping both services
#
# Usage:
#   ./bin/test-demo [--service-only] [--ui-only] [--test-only] [--no-cleanup]
#
# Options:
#   --service-only  Only start the service, don't run tests
#   --ui-only       Only start the UI, don't run tests
#   --test-only     Only run tests, assume services are already running
#   --no-cleanup    Don't stop services after tests
#   --port PORT     Use custom port for service (default: 1241)
#
# Environment variables:
#   WORKFORCE_PLANNING_MANAGEMENT_SERVICE_PORT   Service port (default: 1241)
#   WORKFORCE_PLANNING_MANAGEMENT_UI_PORT        UI port (default: 5173)
#   WORKFORCE_PLANNING_MANAGEMENT_NO_CLEANUP     Don't stop services after tests
#

set -e

# Handle help and version
if [[ "$*" == *"--help"* ]] || [[ "$*" == *"-h"* ]]; then
    echo "Usage: $(basename $0) [OPTIONS]"
    echo ""
    echo "Launch the WPM demo and run end-to-end tests."
    echo ""
    echo "Options:"
    echo "  --service-only    Only start the service, don't run tests"
    echo "  --ui-only         Only start the UI, don't run tests"
    echo "  --test-only       Only run tests, assume services are already running"
    echo "  --no-cleanup      Don't stop services after tests"
    echo "  --port PORT       Use custom port for service (default: 1241)"
    echo "  --help, -h        Show this help message"
    echo ""
    echo "Environment variables:"
    echo "  WORKFORCE_PLANNING_MANAGEMENT_SERVICE_PORT   Service port (default: 1241)"
    echo "  WORKFORCE_PLANNING_MANAGEMENT_UI_PORT        UI port (default: 5173)"
    echo "  WORKFORCE_PLANNING_MANAGEMENT_NO_CLEANUP     Don't stop services after tests"
    echo ""
    echo "Examples:"
    echo "  make test-demo                    # Run full demo with tests"
    echo "  ./bin/test-demo --service-only    # Only start the service"
    echo "  ./bin/test-demo --no-cleanup      # Keep services running after tests"
    exit 0
fi

# Default configuration
SERVICE_DIR="workforce-planning-management-service-with-rust"
UI_DIR="workforce-planning-management-ui-with-svelte"
SERVICE_PORT=${WORKFORCE_PLANNING_MANAGEMENT_SERVICE_PORT:-1241}
UI_PORT=${WORKFORCE_PLANNING_MANAGEMENT_UI_PORT:-5173}
SERVICE_PID=""
UI_PID=""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging functions
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

log_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

log_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Cleanup function
cleanup() {
    if [ -n "$SERVICE_PID" ] && [ "$WORKFORCE_PLANNING_MANAGEMENT_NO_CLEANUP" != "1" ] && [ "$NO_CLEANUP" != "1" ]; then
        log_info "Stopping service (PID: $SERVICE_PID)..."
        kill $SERVICE_PID 2>/dev/null || true
        wait $SERVICE_PID 2>/dev/null || true
    fi
    
    if [ -n "$UI_PID" ] && [ "$WORKFORCE_PLANNING_MANAGEMENT_NO_CLEANUP" != "1" ] && [ "$NO_CLEANUP" != "1" ]; then
        log_info "Stopping UI (PID: $UI_PID)..."
        kill $UI_PID 2>/dev/null || true
        wait $UI_PID 2>/dev/null || true
    fi
    
    log_success "Demo test complete!"
}

# Trap signals for cleanup
trap cleanup EXIT INT TERM

# Check if port is available
wait_for_port() {
    local port=$1
    local max_retries=${2:-30}
    local retry_interval=${3:-1}
    local attempt=0
    
    while ! nc -z localhost $port 2>/dev/null; do
        attempt=$((attempt + 1))
        if [ $attempt -ge $max_retries ]; then
            return 1
        fi
        sleep $retry_interval
    done
    return 0
}

# Parse arguments
SERVICE_ONLY=false
UI_ONLY=false
TEST_ONLY=false
NO_CLEANUP=false

for arg in "$@"; do
    case "$arg" in
        --service-only)
            SERVICE_ONLY=true
            ;;
        --ui-only)
            UI_ONLY=true
            ;;
        --test-only)
            TEST_ONLY=true
            ;;
        --no-cleanup)
            NO_CLEANUP=true
            ;;
        --port)
            SERVICE_PORT=$next_arg
            ;;
        *)
            if [ "$prev_arg" = "--port" ]; then
                SERVICE_PORT=$arg
            fi
            prev_arg=$arg
            ;;
    esac
done

# Validate Node.js and pnpm
if [ "$TEST_ONLY" = false ]; then
    if ! command -v pnpm &> /dev/null; then
        log_error "pnpm is required but not found. Please install pnpm."
        exit 1
    fi
    
    if ! command -v node &> /dev/null; then
        log_error "Node.js is required but not found. Please install Node.js."
        exit 1
    fi
fi

# Validate Rust/Cargo
if [ "$TEST_ONLY" = false ] || [ "$SERVICE_ONLY" = true ]; then
    if ! command -v cargo &> /dev/null; then
        log_error "cargo is required but not found. Please install Rust."
        exit 1
    fi
fi

# Function to check if service is healthy
check_service_health() {
    local port=$1
    local max_retries=${2:-10}
    local attempt=0
    
    while true; do
        attempt=$((attempt + 1))
        if curl -s http://localhost:$port/health > /dev/null 2>&1; then
            return 0
        fi
        if [ $attempt -ge $max_retries ]; then
            return 1
        fi
        sleep 2
    done
}

# Start the service if needed
if [ "$TEST_ONLY" = false ]; then
    log_info "Starting WPM service on port $SERVICE_PORT..."
    
    cd $SERVICE_DIR
    
    # Migrate and seed the database
    log_info "Running database migrations..."
    cargo run --quiet -- db migrate 2>&1 | grep -v "Compiling\|Finished" || true
    
    log_info "Seeding database with demo data..."
    cargo run --quiet -- task seed 2>&1 | grep -v "Compiling\|Finished" || true
    
    # Start the service in the background with auth disabled for demo
    WORKFORCE_PLANNING_MANAGEMENT_REQUIRE_AUTH=0 WORKFORCE_PLANNING_MANAGEMENT_RATE_LIMIT_PER_MINUTE=6000 cargo run --quiet -- start > /tmp/wpm-service.log 2>&1 &
    SERVICE_PID=$!
    
    log_info "Service started with PID: $SERVICE_PID"
    
    # Wait for service to be ready
    log_info "Waiting for service to be ready on port $SERVICE_PORT..."
    if ! wait_for_port $SERVICE_PORT 30 2; then
        log_error "Service failed to start on port $SERVICE_PORT"
        log_error "Check /tmp/wpm-service.log for errors"
        exit 1
    fi
    
    log_success "Service is running on port $SERVICE_PORT"
    
    cd ..
fi

# Start the UI if needed and not test-only
if [ "$TEST_ONLY" = false ] && [ "$UI_ONLY" = false ]; then
    log_info "Starting WPM UI on port $UI_PORT..."
    
    cd $UI_DIR
    
    # Start the UI in the background
    WORKFORCE_PLANNING_MANAGEMENT_DEMO_API_URL=http://localhost:$SERVICE_PORT pnpm dev > /tmp/wpm-ui.log 2>&1 &
    UI_PID=$!
    
    log_info "UI started with PID: $UI_PID"
    
    # Wait for UI to be ready
    log_info "Waiting for UI to be ready on port $UI_PORT..."
    if ! wait_for_port $UI_PORT 30 2; then
        log_error "UI failed to start on port $UI_PORT"
        log_error "Check /tmp/wpm-ui.log for errors"
        exit 1
    fi
    
    log_success "UI is running on port $UI_PORT"
    
    cd ..
fi

# If only starting services, we're done
if [ "$SERVICE_ONLY" = true ] || [ "$UI_ONLY" = true ]; then
    log_success "Services started. Access demo at http://localhost:$UI_PORT"
    log_info "To stop services manually, use: kill $SERVICE_PID $UI_PID"
    # Don't cleanup in this case
    trap - EXIT INT TERM
    tail -f /dev/null
fi

# Run end-to-end tests
if [ "$TEST_ONLY" = false ]; then
    log_info "Running end-to-end tests..."
    
    cd $UI_DIR
    
    # Run Playwright tests with live API
    log_info "Running Playwright end-to-end tests against live demo..."
    WORKFORCE_PLANNING_MANAGEMENT_LIVE_API=1 WORKFORCE_PLANNING_MANAGEMENT_DEMO_API_URL=http://localhost:$SERVICE_PORT PW_PORT=$UI_PORT pnpm exec playwright test -c playwright.live.config.ts 2>&1 || {
        log_warning "Playwright tests had failures"
    }
    
    # Run vitest unit tests
    log_info "Running vitest unit tests..."
    pnpm test 2>&1 || {
        log_warning "Vitest unit tests had failures"
    }
    
    cd ..
    
    log_success "All end-to-end tests completed"
fi

# Cleanup (unless --no-cleanup was specified)
if [ "$NO_CLEANUP" = false ]; then
    log_info "Stopping demo services..."
else
    log_info "Skipping cleanup (--no-cleanup specified)"
fi
