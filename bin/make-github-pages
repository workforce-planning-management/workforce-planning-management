#!/bin/sh
# Publish the GitHub Pages site: push the subdirectory workforce-planning-management.github.io/ to the `main` branch
# of the remote named `github-pages` with git subtree (spec/monorepo-github-pages/, spec/github-pages-site.md). That
# remote's repository (workforce-planning-management/workforce-planning-management.github.io) is a read-only export:
# never work in it, or in a clone of it, directly; change the site here and run this again. See
# workforce-planning-management.github.io/README.md, "Publishing".
#
# Usage: make github-pages   (or: bin/make-github-pages)
set -eu

prefix=workforce-planning-management.github.io
cd "$(dirname "$0")/.."

if ! git remote get-url github-pages >/dev/null 2>&1; then
  echo "make-github-pages: there is no git remote named github-pages." >&2
  echo "Add it once (see $prefix/README.md, \"Publishing\"):" >&2
  echo "  git remote add github-pages git@github.com:workforce-planning-management/workforce-planning-management.github.io.git" >&2
  exit 1
fi

# The site carries its own copy of the documents it shows; refuse to publish a stale copy.
node "$prefix/scripts/sync-content.mjs" --check

if [ -n "$(git status --porcelain -- "$prefix")" ]; then
  echo "make-github-pages: $prefix/ has uncommitted changes; commit them first (subtree pushes commits only)." >&2
  exit 1
fi

git subtree push --prefix="$prefix" github-pages main
